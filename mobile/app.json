{
  "expo": {
    "name": "ARZON",
    "slug": "arzon",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "arzon",
    "userInterfaceStyle": "light",
    "primaryColor": "#E8590C",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F2"
    },
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kg.arzon.app"
    },
    "android": {
      "package": "kg.arzon.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://arzon-backend.onrender.com"
    }
  }
}
