# ARZON — muhit o'zgaruvchilari namunasi.
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring.
# .env fayli hech qachon git'ga qo'shilmasin (.gitignore'да).

# ---------- Ma'lumotlar bazasi ----------
# Boshlang'ich: SQLite. Produksiya: PostgreSQL.
DATABASE_URL=sqlite:///./arzon.db
# DATABASE_URL=postgresql+psycopg2://user:parol@localhost:5432/arzon

# ---------- Telegram botlar (BotFather orqali) ----------
SAVDO_BOT_TOKEN=
BOSHQARUV_BOT_TOKEN=
# Moliya Boti — faqat super-admin (ACOM coin so'rovlari).
MOLIYA_BOT_TOKEN=
# Mini App initData imzosi shu token bilan tekshiriladi (odatda = SAVDO_BOT_TOKEN).
MINIAPP_BOT_TOKEN=
SAVDO_BOT_USERNAME=

# ---------- Claude AI (mijoz chat-yordamchisi — console.anthropic.com) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ---------- Gemini AI (chek/rasm tahlili — ai.google.dev) ----------
# ACOM coin: to'lov chekini o'qish uchun. Mijoz chatи uchun EMAS (u Claude).
GEMINI_API_KEY=

# ---------- ACOM coin tizimi (barcha summalar KGS, 1 ACOM = 1 som) ----------
KOMISSIYA_FOIZI=1
BIR_MARTALIK_TOLDIRISH_LIMIT=300000
KUNLIK_TOLDIRISH_SONI_LIMIT=3

# ---------- Do'kon ochish (pullik so'rov) ----------
# Do'kon ochilgach shu admin botга havola yuboriladi (@siz).
ADMIN_BOT_USERNAME=arzononlineadmin_bot
# Har 10 mahsulot uchun narx (som).
DOKON_ONTALIK_NARXI=100

# ---------- ChromaDB ----------
CHROMA_PERSIST_DIR=./chroma_data

# ---------- Super-adminlar (loyiha egalari) ----------
# Vergul bilan ajratilган Telegram ID'lar. Faqat ular /yangi_dokon bera oladi.
SUPER_ADMIN_IDS=

# ---------- Ichki API tokeni ----------
# Botlar backend'ga shu token bilan murojaat qiladi. Uzun tasodifiy qator bo'lsin.
# Masalan: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ---------- Xavfsizlik ----------
CODE_ATTEMPT_LIMIT=5
CODE_ATTEMPT_WINDOW_SECONDS=60
ORDER_CODE_TTL_DAYS=14
CORS_ORIGINS=*

# ---------- Botlar backend'ga ulanishi ----------
BACKEND_URL=http://localhost:8000
# Mini App URL (Savdo Boti tugmasiда ochiladi)
MINIAPP_URL=

# ---------- Majburiy kanalga obuna (Savdo boti onboarding) ----------
# Bo'sh bo'lса — kanal tekshiruvi o'chiq. Bot kanalда ADMIN bo'lishi kerak.
# NEWS_CHANNEL_ID: @username yoki -100... raqamli ID
NEWS_CHANNEL_ID=
NEWS_CHANNEL_LINK=https://t.me/sizning_kanal

# ---------- Instagram (Meta Graph API) ----------
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_PAGE_TOKEN=
